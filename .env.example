# =============================================================================
# EYTGaming Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eytgaming_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-db-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Email (Development: console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@eytgaming.com

# Social Authentication
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
STEAM_API_KEY=your_steam_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe (Test Keys)
STRIPE_PUBLIC_KEY=pk_test_replace_with_new_key
STRIPE_SECRET_KEY=sk_test_replace_with_new_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_new_key

# Paystack (Test Keys)
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_new_key
PAYSTACK_SECRET_KEY=sk_test_replace_with_new_key
PAYSTACK_WEBHOOK_SECRET=https://your-domain.ngrok-free.app/tournaments/paystack/webhook/

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=replace_with_generated_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_generated_vapid_private_key
VAPID_CLAIM_EMAIL=push@eytgaming.com

# Error Tracking
SENTRY_DSN=

# Site Configuration
SITE_URL=http://localhost:8000
CONTACT_EMAIL=support@eytgaming.com
TIME_ZONE=America/New_York
LANGUAGE_CODE=en-us
