# ==============================================
# PythonAnywhere FREE TIER Configuration
# ==============================================

# Django Core
SECRET_KEY=your-actual-secret-key-here
DEBUG=False
ALLOWED_HOSTS=eytgaming.pythonanywhere.com

# --- Database ---
# Option A: SQLite (simplest — no setup needed)
DATABASE_URL=sqlite:///home/eytgaming/eytgaming/db.sqlite3

# Option B: MySQL (uncomment and comment out DATABASE_URL above)
# DB_USER=eytgaming
# DB_PASSWORD=your_mysql_password
# DB_HOST=eytgaming.mysql.pythonanywhere-services.com
# DB_NAME=eytgaming$default
# DB_PORT=3306

# Site Config
SITE_URL=https://eytgaming.pythonanywhere.com
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# ==============================================
# EMAIL (Console backend = no actual emails sent)
# ==============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Security
CSRF_TRUSTED_ORIGINS=https://eytgaming.pythonanywhere.com

# ==============================================
# DISABLE REDIS/CELERY (NOT AVAILABLE ON FREE TIER)
# ==============================================
# Do not set REDIS_URL or CELERY_BROKER_URL — settings.py
# will auto-detect their absence and use database cache
# and disable Celery.

# ==============================================
# DISABLE RATE LIMITING (optional — works with
# database cache but may be slow)
# ==============================================
RATE_LIMIT_ENABLED=False
RATELIMIT_ENABLE=False
STORE_RATE_LIMIT_ENABLED=False

# ==============================================
# SOCIAL AUTH (leave blank if not configured)
# ==============================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STEAM_API_KEY=

# ==============================================
# PAYMENTS (leave blank if not configured)
# ==============================================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ==============================================
# SOCIAL MEDIA LINKS
# ==============================================
DISCORD_URL=https://discord.gg/eytgaming
TWITTER_URL=https://twitter.com/eytgaming
TWITCH_URL=https://twitch.tv/eytgaming
YOUTUBE_URL=https://youtube.com/@eytgaming
